# Copy to ~/syndi/syndi.env and chmod 600.
# Values are read verbatim: quote anything containing spaces/newlines.
# Full cookie strings migrate as-is from the old RSSHub docker-compose env.

# Zhihu login cookies (required by zhihu member/zhuanlan routes)
ZHIHU_COOKIES=""

# Example: other route credentials
# BILIBILI_COOKIE=""
# TWITTER_AUTH_TOKEN=""
